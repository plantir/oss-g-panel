{
  "name": "Fluent Light",
  "id": "fluent_light",
  "colors": {
    "mode": "light",
    "primary": {
      "main": "#0f6cbd",
      "mainEmphasis": "#115ea3"
    },
    "info": {
      "main": "#0f6cbd",
      "mainEmphasis": "#115ea3"
    },
    "error": {
      "main": "#c50f1f"
    },
    "warning": {
      "main": "#da3b01"
    },
    "success": {
      "main": "#107c10"
    },
    "text": {
      "primary": "#242424",
      "secondary": "#424242",
      "disabled": "#bdbdbd"
    },
    "background": {
      "canvas": "#fafafa",
      "primary": "#ffffff",
      "secondary": "#f5f5f5"
    },
    "border": {
      "weak": "#e0e0e0",
      "medium": "#d1d1d1",
      "strong": "#616161"
    }
