{
  "name": "Fluent Light",
  "id": "fluent_light",
  "colors": {
    "mode": "light",
    "primary": {
      "main": "#0f6cbd",
      "text": "#0f6cbd",
      "contrastText": "#ffffff",
      "shade": "#115ea3",
      "mainEmphasis": "#115ea3"
    },
    "info": {
      "main": "#0f6cbd",
      "text": "#0f6cbd",
      "contrastText": "#ffffff",
      "shade": "#115ea3",
      "mainEmphasis": "#115ea3"
    },
    "secondary": {
      "main": "#f5f5f5",
      "shade": "#ebebeb",
      "text": "#242424",
      "contrastText": "#242424",
      "border": "#d1d1d1"
    },
    "accent": {
      "main": "#0f6cbd",
      "text": "#0f6cbd",
      "contrastText": "#ffffff",
      "shade": "#115ea3",
      "mainEmphasis": "#115ea3"
    },
    "error": {
      "main": "#c50f1f"
    },
    "warning": {
      "main": "#da3b01"
    },
    "success": {
      "main": "#107c10"
    },
    "text": {
      "primary": "#242424",
      "secondary": "#424242",
      "disabled": "#bdbdbd",
      "link": "#0f6cbd"
    },
    "background": {
      "canvas": "#fafafa",
      "primary": "#ffffff",
      "secondary": "#f5f5f5",
      "elevated": "#ffffff"
    },
    "border": {
      "weak": "#e0e0e0",
      "medium": "#d1d1d1",
      "strong": "#616161"
    },
    "action": {
      "hover": "#f5f5f5",
      "selected": "#ebebeb",
      "selectedBorder": "#0f6cbd",
      "focus": "#f5f5f5",
      "disabledBackground": "#f0f0f0"
    },
    "gradients": {
      "brandVertical": "#0f6cbd",
      "brandHorizontal": "#0f6cbd"
    },
    "scrollbar": "#8f8f8f"
  },
  "typography": {
    "fontFamily": "\"Segoe UI\", \"Segoe UI Web (West European)\", -apple-system, BlinkMacSystemFont, Roboto, \"Helvetica Neue\", sans-serif",
    "fontFamilyMonospace": "Consolas, \"Courier New\", monospace",
    "fontSize": 14,
    "htmlFontSize": 16,
    "fontWeightRegular": 400,
    "fontWeightMedium": 600,
    "fontWeightBold": 700
  },
  "shape": {
    "borderRadiusSm": 2,
    "borderRadius": 4,
    "borderRadiusLg": 8
  },
  "shadows": {
    "z1": "0 0 2px rgba(0,0,0,0.12), 0 2px 4px rgba(0,0,0,0.14)",
    "z2": "0 0 2px rgba(0,0,0,0.12), 0 8px 16px rgba(0,0,0,0.14)",
    "z3": "0 0 8px rgba(0,0,0,0.12), 0 32px 64px rgba(0,0,0,0.14)"
  },
  "components": {
    "input": {
      "background": "#ffffff",
      "borderColor": "#d1d1d1"
    },
    "panel": {
      "background": "#ffffff",
      "borderColor": "#e0e0e0",
      "headerHeight": 4
    },
    "switch": {
      "activeBackground": "#0f6cbd",
      "activeBackgroundHover": "#115ea3"
    },
    "checkbox": {
      "activeBackground": "#0f6cbd",
      "activeBackgroundHover": "#115ea3"
    },
    "overlay": {
      "background": "rgba(0, 0, 0, 0.4)"
    },
    "menu": {
      "borderRadius": "default"
    },
    "table": {
      "rowHoverBackground": "#f5f5f5",
      "rowSelected": "#ebebeb"
    },
    "codeEditor": {
      "keyword": "#0f6cbd",
      "controlKeyword": "#3848c6",
      "variable": "#242424",
      "type": "#026c6c",
      "function": "#705da0",
      "number": "#b15415",
      "string": "#107c10",
      "operator": "#424242",
      "regexp": "#b83300",
      "comment": "#616161",
      "heading": "#0f6cbd",
      "link": "#0f6cbd",
      "invalid": "#c50f1f"
    },
    "tag": {
      "colors": [
        { "background": "#0f6cbd", "text": "#ffffff" },
        { "background": "#c239b3", "text": "#ffffff" },
        { "background": "#13a10e", "text": "#ffffff" },
        { "background": "#ca5010", "text": "#ffffff" },
        { "background": "#4f6bed", "text": "#ffffff" },
        { "background": "#038387", "text": "#ffffff" },
        { "background": "#8764b8", "text": "#ffffff" },
        { "background": "#c19c00", "text": "#ffffff" },
        { "background": "#d13438", "text": "#ffffff" },
        { "background": "#00b7c3", "text": "#ffffff" }
      ]
    },
    "home": {
      "background": {
        "fade": "#fafafa",
        "highlight": "transparent",
        "right": "rgba(15, 108, 189, 0.08)",
        "left": "rgba(15, 108, 189, 0.06)"
      }
    }
  },
  "visualization": {
    "palette": [
      "#0f6cbd",
      "#c239b3",
      "#13a10e",
      "#ca5010",
      "#4f6bed",
      "#038387",
      "#8764b8",
      "#c19c00",
      "#d13438",
      "#00b7c3"
    ],
    "hues": [
      { "name": "green", "shades": [{ "name": "green", "color": "#13a10e" }] },
      { "name": "yellow", "shades": [{ "name": "yellow", "color": "#c19c00" }] },
      { "name": "blue", "shades": [{ "name": "blue", "color": "#0f6cbd" }] },
      { "name": "orange", "shades": [{ "name": "orange", "color": "#ca5010" }] },
      { "name": "red", "shades": [{ "name": "red", "color": "#d13438" }] },
      { "name": "purple", "shades": [{ "name": "purple", "color": "#8764b8" }] }
    ]
  }
}
